<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Cloudict.App.Localization"
        x:Class="Cloudict.App.Views.MainWindow"
        Title="{loc:Tr Main_WindowTitle}"
        Width="520" Height="820"
        MinWidth="470" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Cloudict/Assets/app-icon.ico"
        FontFamily="{DynamicResource AppFontFamily}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Background="{DynamicResource BgWindowBrush}">

  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Header: settings button on the leading edge, logo and version centred -->
    <Grid Grid.Row="0" Margin="0,4,0,0">
      <Button x:Name="BtnSettings" Classes="subtle"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Height="36" Padding="12,0" Margin="10,6,0,0"
              Click="OnSettingsClick"
              ToolTip.Tip="{loc:Tr Common_Settings}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="18" Height="18" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}"
                Data="{StaticResource IconGear}"/>
          <TextBlock Text="{loc:Tr Common_Settings}" Margin="8,0,0,0" FontSize="13"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </Button>

      <!--
        The name is set as text rather than baked into the logo bitmap. The full logo carries the
        wordmark as artwork, and squeezing that into sixty pixels turned the letters into a smear —
        a bitmap cannot stay sharp at a tenth of its size, or at a display scale it was not drawn
        for. Only the cloud-and-microphone mark is a picture now; "Cloudict" is real type, in the
        two weights the logo uses, and stays crisp at any size and any DPI.

        The whole lockup reads left-to-right even in Persian, because the name is Latin.
      -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                  FlowDirection="LeftToRight" Spacing="11" Margin="0,4,0,0">
        <Image Source="avares://Cloudict/Assets/logo-mark.png" Height="46" Width="46"
               Stretch="Uniform" VerticalAlignment="Center"/>

        <TextBlock VerticalAlignment="Center" FontSize="27"
                   FontFamily="{DynamicResource InterFont}">
          <Run Text="Cloud" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text="ict" FontWeight="Normal"
               Foreground="{DynamicResource TextSecondaryBrush}"/>
        </TextBlock>

        <Border Classes="badge" VerticalAlignment="Center" Margin="0,4,0,0">
          <TextBlock x:Name="TxtVersion" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Controls -->
    <StackPanel Grid.Row="1" Margin="0,3,0,15">
      <Button x:Name="BtnHelperBrowser" Classes="accent"
              HorizontalAlignment="Center" Padding="20,11" Margin="0,0,0,8"
              Click="OnHelperBrowserClick">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path x:Name="IconBrowser" Width="18" Height="18" Stretch="Uniform"
                     Fill="White" VerticalAlignment="Center"
                     Data="{StaticResource IconGlobe}"/>
          <TextBlock x:Name="TxtBrowserLabel" Text="{loc:Tr Main_OpenHelperBrowser}"
                     FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8" Spacing="20">
        <Button x:Name="BtnStart" Classes="circle success" Click="OnStartClick"
                ToolTip.Tip="{loc:Tr Main_MicControlsHint}">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="White" Data="{StaticResource IconPlay}"/>
        </Button>
        <Button x:Name="BtnStop" Classes="circle accent" Click="OnStopClick"
                ToolTip.Tip="{loc:Tr Main_MicControlsHint}">
          <Border Width="12" Height="12" CornerRadius="2" Background="White"/>
        </Button>
      </StackPanel>

      <TextBlock Text="{loc:Tr Main_MicControlsHint}" FontSize="14"
                 HorizontalAlignment="Center" Margin="0,8,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>

    <!--
      Both boxes follow the same shape: the label above, the text and its two icon buttons side by
      side, and whatever belongs to that box underneath. Copy and clear moved out of the row below
      and became icon-only discs beside the text because the row had run out of width — adding the
      system-audio button pushed its contents past the edge of the card — and because these two are
      the same pair on both boxes, so they read better as a fixed pair of marks than as another two
      labelled buttons competing with the ones that matter.
    -->
    <Border Grid.Row="2" Classes="card" Margin="15,8,15,8">
      <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{loc:Tr Main_RecognizedLabel}" Classes="h2"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="10,0,0,0">
            <Button Classes="icon" Click="OnCopyRecognizedClick"
                    ToolTip.Tip="{loc:Tr Main_CopyBtn}">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" Data="{StaticResource IconCopy}"/>
            </Button>
            <Button Classes="icon danger" Click="OnClearRecognizedClick"
                    ToolTip.Tip="{loc:Tr Main_ClearBtn}">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource AccentHoverBrush}" Data="{StaticResource IconTrash}"/>
            </Button>
          </StackPanel>

          <TextBox Grid.Column="0" x:Name="TxtRecognized"
                   IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   FontSize="12" MinHeight="60" MaxHeight="90"
                   Watermark="{loc:Tr Main_WaitingForSpeech}"
                   VerticalContentAlignment="Top"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,10,0,0">
          <Button Classes="accent" Content="{loc:Tr Main_QuickTransfer}" Click="OnQuickTransferClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Final text -->
    <Border Grid.Row="3" Classes="card" Margin="15,8,15,8">
      <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{loc:Tr Main_FinalLabel}" Classes="h2"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="10,0,0,0">
            <Button Classes="icon" Click="OnCopyFinalClick"
                    ToolTip.Tip="{loc:Tr Main_CopyBtn}">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" Data="{StaticResource IconCopy}"/>
            </Button>
            <Button Classes="icon danger" Click="OnClearFinalClick"
                    ToolTip.Tip="{loc:Tr Common_Clear}">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource AccentHoverBrush}" Data="{StaticResource IconTrash}"/>
            </Button>
          </StackPanel>

          <TextBox Grid.Column="0" x:Name="TxtFinal"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   FontSize="13" MinHeight="80"
                   Watermark="{loc:Tr Main_FinalPlaceholder}"
                   VerticalContentAlignment="Top"/>
        </Grid>

        <!-- The two modes, as switches rather than buttons: they are states that stay on, and a
             button press reads as an action that happens once. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,2" Spacing="9">
          <ToggleSwitch x:Name="BtnLiveTransfer" Classes="mode"
                        OnContent="{loc:Tr Main_TransferToCursor}"
                        OffContent="{loc:Tr Main_TransferToCursor}"
                        Click="OnLiveTransferClick"/>
          <ToggleSwitch x:Name="BtnSystemAudio" Classes="mode"
                        OnContent="{loc:Tr Main_SystemAudio}"
                        OffContent="{loc:Tr Main_SystemAudio}"
                        ToolTip.Tip="{loc:Tr Main_SystemAudioTip}"
                        Click="OnSystemAudioClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer links always read left-to-right -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,2,0,6" Spacing="8" FlowDirection="LeftToRight">
      <Button Classes="subtle" Padding="12,7" Tag="https://github.com/farshad-zamani" Click="OnOpenUrlClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                Data="{StaticResource IconGitHub}"/>
          <TextBlock Text="{loc:Tr Main_GitHub}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Classes="subtle" Padding="12,7" Tag="https://www.linkedin.com/in/farshad-zamani92/" Click="OnOpenUrlClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="#0A66C2"
                Data="{StaticResource IconLinkedIn}"/>
          <TextBlock Text="LinkedIn" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Classes="subtle" Padding="12,7" Tag="https://cloudtart.com" Click="OnOpenUrlClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                Data="{StaticResource IconGlobe}"/>
          <TextBlock Text="{loc:Tr Main_Website}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Status. Wraps rather than clipping: driver and browser messages run long. -->
    <Border Grid.Row="5" Background="{DynamicResource BgPanelBrush}" MinHeight="35" Padding="8,5">
      <TextBlock x:Name="TxtStatus" Classes="status" VerticalAlignment="Center" MaxHeight="64"/>
    </Border>

  </Grid>
</Window>
