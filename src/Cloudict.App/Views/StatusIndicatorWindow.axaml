<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cloudict.App.Views.StatusIndicatorWindow"
        Width="56" Height="56"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ToolTip.Tip="{Binding StatusText, RelativeSource={RelativeSource Self}}">

  <!--
    A small always-on-top badge showing whether the microphone is live. It exists because the
    helper browser and the user's own application cover Cloudict's window, so the state has to be
    readable without switching to it.
  -->
  <Panel Margin="4">

    <!-- Soft halo, so the badge stays legible over any wallpaper or window behind it. -->
    <Ellipse x:Name="Halo" Width="48" Height="48" Opacity="0.28"/>

    <Border x:Name="Disc" Width="40" Height="40" CornerRadius="20"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#3E9080" BorderBrush="#22FFFFFF" BorderThickness="1">
      <Border.Transitions>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25"/>
        </Transitions>
      </Border.Transitions>

      <!-- Microphone glyph: capsule, arc and stand, drawn rather than taken from a font so it
           looks the same on all three systems.

           Only the height is fixed. A Path scales its geometry to the top-left of its own box, so
           giving it a square 20x20 while the glyph is taller than it is wide left roughly 2.6px of
           empty box on the right - which read as the microphone sitting left of centre in the disc.
           With the width free, the shape measures to its true scaled width and the centring below
           has something correct to centre. -->
      <!-- Both glyphs share the disc; exactly one is visible at a time. -->
      <Panel>
      <!-- Speaker with waves: shown instead of the microphone while the badge is reporting the
           machine's own audio rather than the room's, so which of the two is being listened to is
           unmistakable at a glance. -->
      <Path x:Name="SystemGlyph" Height="20" Stretch="Uniform"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="False"
            Fill="White"
            Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>

      <Path x:Name="MicGlyph" Height="21" Stretch="Uniform"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Fill="White"
            Data="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.49 6-3.31 6-6.72h-1.7z"/>
      </Panel>
    </Border>

    <!-- A slash across the glyph when idle: colour alone is not enough for a colour-blind user,
         and it reads instantly at this size. Sized to stay inside the 40px disc - stretching it
         across the whole panel drew the line out past the circle's edge. -->
    <Path x:Name="MutedSlash" Width="24" Height="24" Stretch="Uniform"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsVisible="False"
          Stroke="White" StrokeThickness="2" StrokeLineCap="Round"
          Data="M4 4 L20 20"/>
  </Panel>
</Window>
