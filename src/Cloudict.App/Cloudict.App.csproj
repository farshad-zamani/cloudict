<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform front end. One project builds the Windows, Linux and macOS applications;
       everything below it (Cloudict.Core, Cloudict.Platform) is already platform-neutral. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Cloudict.App</RootNamespace>
    <AssemblyName>Cloudict</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CS8632;AVLN2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Selenium.WebDriver" Version="4.31.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cloudict.Core\Cloudict.Core.csproj" />
    <ProjectReference Include="..\Cloudict.Platform\Cloudict.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- ChromeDriver ships beside the app so the first run never needs the network. The correct
       build per platform is selected by scripts/fetch-chromedriver.ps1. -->
  <ItemGroup>
    <Content Include="Drivers\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

