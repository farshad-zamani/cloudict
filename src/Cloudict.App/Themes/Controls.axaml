<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Control styling. Avalonia styles are selector-based rather than the keyed Style objects WPF
       uses, so these are expressed as classes: Classes="accent" on a Button, and so on. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgWindowBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
  </Style>

  <Style Selector="Button.success">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.success /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.success:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
  </Style>

  <Style Selector="Button.warning">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.warning /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <!--
    A small round icon-only button, used for the copy and clear marks beside each text box. Quiet by
    default and only picking up a background on hover: there are four of them on the window and they
    are conveniences, not the controls the eye should land on first.
  -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
  </Style>
  <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- The two mode switches under the final text. -->
  <Style Selector="ToggleSwitch.mode">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleSwitch.mode:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Fluent's switch is blue; these are the app's own greens and greys. -->
  <Style Selector="ToggleSwitch.mode:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch.mode:unchecked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource BgWindowBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch.mode:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessHoverBrush}"/>
  </Style>

  <!-- A round transport button (start / stop). -->
  <Style Selector="Button.circle">
    <Setter Property="Width" Value="50"/>
    <Setter Property="Height" Value="50"/>
    <Setter Property="CornerRadius" Value="25"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>

  <!-- Text boxes -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Padding" Value="6"/>
  </Style>

  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{DynamicResource BgWindowBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,6"/>
  </Style>

  <!-- Cards / panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="7,2"/>
  </Style>

  <!-- Headings -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="23"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!--
    Tabs, as pills rather than an underline.

    Fluent marks the selected tab with a short bar underneath it (PART_SelectedPipe). At this font
    size it sat loose under the label, its width unrelated to the text above it, and with the header
    row it looked like a stray line rather than a selection. A filled rounded chip is unambiguous,
    matches the rounded cards everywhere else in the app, and mirrors correctly in Persian without
    any extra work — which a hand-placed underline does not.
  -->
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="17,9"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="MinHeight" Value="0"/>

    <!-- The whole template, not just its colours. Hiding Fluent's PART_SelectedPipe left the bar
         still occupying its row, and the chip then sat above a gap; owning the template means the
         underline does not exist in the first place. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Chip"
                Background="{TemplateBinding Background}"
                CornerRadius="9"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
          </Border.Transitions>

          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="TabItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- Keeps the strip clear of the panel below it. -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0,10,0,0"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BgWindowBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <Style Selector="ToggleButton /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>

</Styles>
