<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application logic with no UI framework and no operating-system calls. Everything here must
       compile and run identically on Windows, Linux and macOS, which is what makes the app
       portable at all. Anything needing the OS goes behind an interface in Abstractions/ and is
       implemented in Cloudict.Platform; anything needing a screen belongs in Cloudict.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Cloudict</RootNamespace>
    <AssemblyName>Cloudict.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS8632</NoWarn>
    <!-- No <UseWPF>, no <RuntimeIdentifier>: keeping this project framework-free is enforced by
         the fact that it simply cannot reference System.Windows.* here. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
