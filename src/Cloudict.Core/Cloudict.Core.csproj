<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application logic with no UI framework and no operating-system calls. Everything here must
       compile and run identically on Windows, Linux and macOS, which is what makes the app
       portable at all. Anything needing the OS goes behind an interface in Abstractions/ and is
       implemented in Cloudict.Platform; anything needing a screen belongs in Cloudict.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Cloudict</RootNamespace>
    <AssemblyName>Cloudict.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS8632</NoWarn>
    <!-- No <UseWPF>, no <RuntimeIdentifier>: keeping this project framework-free is enforced by
         the fact that it simply cannot reference System.Windows.* here. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests reach helpers that are deliberately not part of the public surface. -->
    <InternalsVisibleTo Include="Cloudict.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Selenium drives the helper browser. It is cross-platform and is application logic, not an
         OS call, so it belongs here rather than behind a platform interface. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.31.0" />
  </ItemGroup>


  <!-- UI strings travel with Core so the same dictionary serves the UI, Core and the platform
       layer. Logical names keep the "Cloudict.Localization.Strings.*" form the loader expects.

       WithCulture=false is required, not cosmetic: the SDK's AssignCulture target reads the ".en."
       and ".fa." in these filenames as culture designators and routes the files into satellite
       assemblies, leaving the main assembly with no resources at all. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\Strings.en.json"
                      LogicalName="Cloudict.Localization.Strings.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\Strings\Strings.fa.json"
                      LogicalName="Cloudict.Localization.Strings.Strings.fa.json" WithCulture="false" />
  </ItemGroup>

</Project>
