<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Cloudict</RootNamespace>
    <AssemblyName>Cloudict</AssemblyName>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Folder publish (not single-file): embedded WPF fonts fail to initialize inside a
         single-file bundle, so we ship a self-contained folder instead. The app already
         needs the driver folder beside the executable anyway. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>NU1701;CS8632;CS8622;CS8625;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Application logic and OS integration now live in their own projects so the same code can be
       driven by an Avalonia front-end on Linux and macOS. This project is the Windows/WPF shell. -->
  <ItemGroup>
    <ProjectReference Include="..\Cloudict.Core\Cloudict.Core.csproj" />
    <ProjectReference Include="..\Cloudict.Platform\Cloudict.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Selenium drives the helper browser; Newtonsoft is used by settings and the driver index.
         AngleSharp, Polly, SharpZipLib, Microsoft.Extensions.DependencyInjection and
         System.Reactive.Windows.Forms were referenced but never used anywhere, and are gone. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Selenium.WebDriver" Version="4.31.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\**\*.ttf" />
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Inter-Bold.ttf" />
  </ItemGroup>

  <!-- ChromeDriver ships with the app so the first run never needs the network. Google's driver
       host is unreachable from several regions (403 / TLS reset), which used to leave the browser
       unpreparable. BrowserProvisioner picks the newest driver on the machine, so this bundled
       copy is a floor, not a ceiling: a newer driver already installed locally still wins.
       Run scripts\fetch-chromedriver.ps1 to refresh it for a newer Chrome. -->
  <ItemGroup>
    <Content Include="Drivers\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
